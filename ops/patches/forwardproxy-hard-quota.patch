+package forwardproxy
+
+import (
+	"bytes"
+	"context"
+	"encoding/base64"
+	"encoding/binary"
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/modules/caddyhttp"
+	"io"
+	"net"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+)
+
+func TestHardQuotaBeforeForwardAndPartialBudget(t *testing.T) {
+	dir, e := os.MkdirTemp("/tmp", "gx-hard-")
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer os.RemoveAll(dir)
+	path := filepath.Join(dir, "quota.sock")
+	l, e := net.Listen("unix", path)
+	if e != nil {
+		t.Fatal(e)
+	}
+	defer l.Close()
+	go func() {
+		c, e := l.Accept()
+		if e != nil {
+			return
+		}
+		defer c.Close()
+		var frame [42]byte
+		io.ReadFull(c, frame[:])
+		var reply [5]byte
+		reply[0] = 1
+		binary.BigEndian.PutUint32(reply[1:], 3)
+		c.Write(reply[:])
+	}()
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	c := &hardQuotaConn{Conn: a, budget: &hardBudget{path, "00000000-0000-4000-8000-000000000001"}}
+	result := make(chan []byte, 1)
+	go func() { payload, _ := io.ReadAll(b); result <- payload }()
+	n, e := c.Write([]byte("123456789"))
+	if n != 3 || e == nil {
+		t.Fatal("quota boundary", n, e)
+	}
+	if payload := <-result; !bytes.Equal(payload, []byte("123")) {
+		t.Fatalf("unreserved bytes forwarded: %q", payload)
+	}
+}
+func TestHardQuotaBrokerLossNeverForwards(t *testing.T) {
+	a, b := net.Pipe()
+	defer a.Close()
+	defer b.Close()
+	c := &hardQuotaConn{Conn: a, budget: &hardBudget{filepath.Join(t.TempDir(), "missing"), "00000000-0000-4000-8000-000000000001"}}
+	if n, e := c.Write([]byte("payload")); n != 0 || e == nil {
+		t.Fatal("broker loss bypassed", n, e)
+	}
+	payload, _ := io.ReadAll(b)
+	if len(payload) != 0 {
+		t.Fatal("payload forwarded before grant")
+	}
+}
+
+func TestHardQuotaActivationRevokesUnmeteredGenerations(t *testing.T) {
+	token := "Basic " + base64.StdEncoding.EncodeToString([]byte("00000000-0000-4000-8000-000000000001:synthetic"))
+	key := credentialHash(token)
+	old := &LiveCredentials{Keys: []string{key}}
+	if e := old.Provision(caddy.Context{}); e != nil {
+		t.Fatal(e)
+	}
+	old.Start()
+	defer old.Stop()
+	legacyCtx, legacyCancel := context.WithCancel(context.Background())
+	defer legacyCancel()
+	_, done, ok := trackCredentialFlow(token, legacyCancel, false)
+	if !ok {
+		t.Fatal("legacy refused before activation")
+	}
+	defer done()
+	hardCtx, hardCancel := context.WithCancel(context.Background())
+	defer hardCancel()
+	_, hardDone, ok := trackCredentialFlow(token, hardCancel, true)
+	if !ok {
+		t.Fatal("metered refused")
+	}
+	defer hardDone()
+	next := &LiveCredentials{Keys: []string{key}, HardQuotaRequired: true}
+	if e := next.Provision(caddy.Context{}); e != nil {
+		t.Fatal(e)
+	}
+	next.Start()
+	defer next.Stop()
+	select {
+	case <-legacyCtx.Done():
+	default:
+		t.Fatal("unmetered stream survived activation")
+	}
+	select {
+	case <-hardCtx.Done():
+		t.Fatal("metered stream interrupted")
+	default:
+	}
+	_, _, ok = trackCredentialFlow(token, func() {}, false)
+	if ok {
+		t.Fatal("old generation accepted new unmetered stream")
+	}
+}
+
+func TestHardQuotaRejectsUnmeteredForwardHTTP(t *testing.T) {
+	h := &Handler{GuardexHardQuota: true}
+	r := httptest.NewRequest(http.MethodGet, "http://external.invalid/payload", nil)
+	r = r.WithContext(context.WithValue(r.Context(), caddy.ReplacerCtxKey, caddy.NewReplacer()))
+	e := h.ServeHTTP(httptest.NewRecorder(), r, nil)
+	status, ok := e.(caddyhttp.HandlerError)
+	if !ok || status.StatusCode != http.StatusMethodNotAllowed {
+		t.Fatal("non-CONNECT proxy bypass", e)
+	}
+}
