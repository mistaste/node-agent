@@ -0,0 +1,126 @@
+package forwardproxy
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"os"
+	"path/filepath"
+	"strings"
+	"time"
+)
+
+var errHardQuota = errors.New("traffic_quota_exhausted")
+
+type hardBudget struct{ path, id string }
+
+func newHardBudget(authorization string, required bool) (*hardBudget, error) {
+	if !required {
+		return nil, nil
+	}
+	path := os.Getenv("GUARDEX_HARD_QUOTA_SOCKET")
+	if !filepath.IsAbs(path) {
+		return nil, errors.New("mandatory quota broker unavailable")
+	}
+	fields := strings.Fields(authorization)
+	if len(fields) != 2 || !strings.EqualFold(fields[0], "Basic") {
+		return nil, errHardQuota
+	}
+	raw, e := base64.StdEncoding.DecodeString(fields[1])
+	if e != nil {
+		return nil, errHardQuota
+	}
+	id, _, ok := strings.Cut(string(raw), ":")
+	if !ok || len(id) != 36 {
+		return nil, errHardQuota
+	}
+	return &hardBudget{path, id}, nil
+}
+func (b *hardBudget) grant(n int, direction byte) (int, error) {
+	if n < 1 || n > 65536 {
+		return 0, errHardQuota
+	}
+	c, e := net.DialTimeout("unix", b.path, time.Second)
+	if e != nil {
+		return 0, e
+	}
+	defer c.Close()
+	c.SetDeadline(time.Now().Add(3 * time.Second))
+	var frame [42]byte
+	copy(frame[:36], b.id)
+	frame[36] = direction
+	binary.BigEndian.PutUint32(frame[38:], uint32(n))
+	if _, e = c.Write(frame[:]); e != nil {
+		return 0, e
+	}
+	var reply [5]byte
+	if _, e = io.ReadFull(c, reply[:]); e != nil {
+		return 0, e
+	}
+	granted := int(binary.BigEndian.Uint32(reply[1:]))
+	if reply[0] != 1 || granted < 1 || granted > n {
+		return 0, errHardQuota
+	}
+	return granted, nil
+}
+
+type hardQuotaConn struct {
+	net.Conn
+	budget *hardBudget
+}
+
+func (c *hardQuotaConn) Read(p []byte) (int, error) {
+	if len(p) > 16384 {
+		p = p[:16384]
+	}
+	n, e := c.Conn.Read(p)
+	if n == 0 {
+		return n, e
+	}
+	granted, err := c.budget.grant(n, 1)
+	if err != nil {
+		c.Conn.Close()
+		return 0, err
+	}
+	if granted < n {
+		c.Conn.Close()
+		return granted, errHardQuota
+	}
+	return n, e
+}
+func (c *hardQuotaConn) Write(p []byte) (int, error) {
+	total := 0
+	for len(p) > 0 {
+		n := len(p)
+		if n > 16384 {
+			n = 16384
+		}
+		granted, e := c.budget.grant(n, 0)
+		if e != nil {
+			c.Conn.Close()
+			return total, e
+		}
+		sent, e := c.Conn.Write(p[:granted])
+		total += sent
+		p = p[sent:]
+		if e != nil {
+			return total, e
+		}
+		if sent != granted {
+			return total, io.ErrShortWrite
+		}
+		if granted < n {
+			c.Conn.Close()
+			return total, errHardQuota
+		}
+	}
+	return total, nil
+}
+func (c *hardQuotaConn) CloseWrite() error {
+	if w, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return w.CloseWrite()
+	}
+	return nil
+}
