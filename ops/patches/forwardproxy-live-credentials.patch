+func TestLiveCredentialsCaddyfileAdapter(t *testing.T) {
+	key := strings.Repeat("a", 64)
+	config := "{\n guardex_credentials " + key + "\n}\nhttp://127.0.0.1:9876 {\n forward_proxy {\n guardex_live_credentials\n basic_auth synthetic password\n }\n}\n"
+	raw, _, err := caddyconfig.GetAdapter("caddyfile").Adapt([]byte(config), nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var parsed struct {
+		Apps map[string]json.RawMessage `json:"apps"`
+	}
+	if err := json.Unmarshal(raw, &parsed); err != nil {
+		t.Fatal(err)
+	}
+	if len(parsed.Apps["guardex_credentials"]) == 0 {
+		t.Fatal("credential app not emitted by adapter")
+	}
+	emptyConfig := strings.Replace(config, "guardex_credentials "+key, "guardex_credentials", 1)
+	raw, _, err = caddyconfig.GetAdapter("caddyfile").Adapt([]byte(emptyConfig), nil)
+	if err != nil {
+		t.Fatal("explicit empty adapter rejected", err)
+	}
+	if err := json.Unmarshal(raw, &parsed); err != nil {
+		t.Fatal(err)
+	}
+	var empty struct {
+		Keys json.RawMessage `json:"keys"`
+	}
+	if err := json.Unmarshal(parsed.Apps["guardex_credentials"], &empty); err != nil {
+		t.Fatal(err)
+	}
+	if string(empty.Keys) != "[]" {
+		t.Fatalf("explicit empty serialized as missing/null: %s", empty.Keys)
+	}
+
+}
