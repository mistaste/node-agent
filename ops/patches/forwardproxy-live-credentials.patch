+func TestLiveCredentialsRejectMissingInventoryAndCleanupIsIdempotent(t *testing.T) {
+	if e := (&LiveCredentials{}).Provision(caddy.Context{}); e == nil {
+		t.Fatal("missing inventory accepted as deny-all")
+	}
+	app := &LiveCredentials{Keys: []string{}}
+	if e := app.Provision(caddy.Context{}); e != nil {
+		t.Fatal("explicit empty rejected", e)
+	}
+	app.Start()
+	app.Cleanup()
+	app.Stop()
+	app.Cleanup()
+	if liveCredentialFlows.current == app {
+		t.Fatal("unloaded app remains authoritative")
+	}
+}
