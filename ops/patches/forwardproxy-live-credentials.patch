+)
+
+func TestLiveCredentialAppPublishesOnlyOnStartAndRollsBack(t *testing.T) {
+	a := &LiveCredentials{Keys: []string{strings.Repeat("a", 64)}}
+	b := &LiveCredentials{Keys: []string{strings.Repeat("b", 64)}}
+	if e := a.Provision(caddy.Context{}); e != nil {
+		t.Fatal(e)
+	}
+	if e := b.Provision(caddy.Context{}); e != nil {
+		t.Fatal(e)
+	}
+	a.Start()
+	defer a.Stop()
+	if liveCredentialFlows.current != a {
+		t.Fatal("not activated")
+	}
+	// Provisioning a candidate must not affect live traffic.
+	if liveCredentialFlows.current == b {
+		t.Fatal("unstarted configuration published")
+	}
+	b.Start()
+	b.Stop() // simulate another app failing to start during reload
+	if liveCredentialFlows.current != a {
+		t.Fatal("failed reload did not restore old authority")
+	}
+	b.Start()
+	a.Stop() // successful reload unloads previous app
+	if liveCredentialFlows.current != b {
+		t.Fatal("old cleanup removed new authority")
+	}
+	b.Stop()
+	if liveCredentialFlows.current != nil {
+		t.Fatal("stopped authority resurrected")
+	}
+}
+
+func TestLiveCredentialsRevokeOnlyRemovedUserAcrossCaddyReload(t *testing.T) {
+	// Actual Caddy app start/stop + real HTTP/1 and HTTP/2 CONNECT streams.
+	// No public listeners, persisted configuration, certificates or real users.
+	echo, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer echo.Close()
+	go func() {
+		for {
+			c, e := echo.Accept()
+			if e != nil {
+				return
+			}
+			go func() { defer c.Close(); io.Copy(c, c) }()
+		}
+	}()
+	proxy, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := proxy.Addr().String()
+	proxy.Close()
+	one := base64.StdEncoding.EncodeToString([]byte("alice:synthetic-one"))
+	two := base64.StdEncoding.EncodeToString([]byte("bob:synthetic-two"))
+	postStartFailure := false
+	load := func(tokens []string, invalid bool) error {
+		encoded := make([]string, len(tokens))
+		for i, token := range tokens {
+			encoded[i] = base64.StdEncoding.EncodeToString([]byte(token))
+		}
+		keys := make([]string, len(tokens))
+		for i, token := range tokens {
+			keys[i] = credentialHash("Basic " + token)
+		}
+		app := map[string]any{"keys": keys}
+		if invalid {
+			app["keys"] = []string{"invalid"}
+		}
+		config := map[string]any{
+			"admin": map[string]any{"disabled": true, "config": map[string]bool{"persist": false}},
+			"apps": map[string]any{
+				"guardex_credentials": app,
+				"http": map[string]any{"servers": map[string]any{"quota": map[string]any{
+					"listen": []string{addr}, "protocols": []string{"h1", "h2c"},
+					"routes": []any{map[string]any{"handle": []any{map[string]any{
+						"handler": "forward_proxy", "auth_credentials": encoded, "guardex_live_credentials": true,
+						"acl": []any{map[string]any{"subjects": []string{"127.0.0.1"}, "allow": true}},
+					}}}},
+				}}},
+			},
+		}
+		if postStartFailure {
+			// finishSettingUp loads this after every App.Start has succeeded.
+			config["admin"].(map[string]any)["config"] = map[string]any{"persist": false, "load": map[string]any{"module": "guardex_missing_config_loader_for_regression"}}
+		}
+		raw, e := json.Marshal(config)
+		if e != nil {
+			return e
+		}
+		return caddy.Load(raw, true)
+	}
+	if e := load([]string{one, two}, false); e != nil {
+		t.Fatal(e)
+	}
+	defer caddy.Stop()
+	type flow struct {
+		reader io.Reader
+		writer io.Writer
+		close  func()
+	}
+	h1 := func(token string) flow {
+		t.Helper()
+		c, e := net.DialTimeout("tcp", addr, time.Second)
+		if e != nil {
+			t.Fatal(e)
+		}
+		c.SetDeadline(time.Now().Add(5 * time.Second))
+		fmt.Fprintf(c, "CONNECT %s HTTP/1.1\r\nHost: %s\r\nProxy-Authorization: Basic %s\r\n\r\n", echo.Addr(), echo.Addr(), token)
+		r := bufio.NewReader(c)
+		response, e := http.ReadResponse(r, nil)
+		if e != nil {
+			c.Close()
+			t.Fatal(e)
+		}
+		if response.StatusCode != 200 {
+			c.Close()
+			t.Fatal("CONNECT rejected", response.StatusCode)
+		}
+		return flow{r, c, func() { c.Close() }}
+	}
+	h2 := func(token string) flow {
+		t.Helper()
+		transport := &http2.Transport{AllowHTTP: true, DialTLSContext: func(ctx context.Context, network, address string, _ *tls.Config) (net.Conn, error) {
+			return (&net.Dialer{}).DialContext(ctx, "tcp", addr)
+		}}
+		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+		reader, writer := io.Pipe()
+		req, e := http.NewRequestWithContext(ctx, "CONNECT", "http://"+echo.Addr().String(), reader)
+		if e != nil {
+			t.Fatal(e)
+		}
+		req.Header.Set("Proxy-Authorization", "Basic "+token)
+		response, e := transport.RoundTrip(req)
+		if e != nil {
+			cancel()
+			t.Fatal(e)
+		}
+		if response.StatusCode != 200 {
+			cancel()
+			t.Fatal("H2 CONNECT rejected", response.StatusCode)
+		}
+		return flow{response.Body, writer, func() { cancel(); writer.Close(); response.Body.Close(); transport.CloseIdleConnections() }}
+	}
+	exchange := func(f flow) error {
+		result := make(chan error, 1)
+		go func() {
+			_, e := f.writer.Write([]byte("quota"))
+			if e == nil {
+				b := make([]byte, 5)
+				_, e = io.ReadFull(f.reader, b)
+				if e == nil && string(b) != "quota" {
+					e = fmt.Errorf("bad echo")
+				}
+			}
+			result <- e
+		}()
+		select {
+		case e := <-result:
+			return e
+		case <-time.After(time.Second):
+			return fmt.Errorf("flow timeout")
+		}
+	}
+	a1, b1, a2, b2 := h1(one), h1(two), h2(one), h2(two)
+	defer a1.close()
+	defer b1.close()
+	defer a2.close()
+	defer b2.close()
+	for _, f := range []flow{a1, b1, a2, b2} {
+		if e := exchange(f); e != nil {
+			t.Fatal("baseline", e)
+		}
+	}
+
+	metrics := func() map[string]struct {
+		Inbound  int64 `json:"inbound"`
+		Outbound int64 `json:"outbound"`
+	} {
+		t.Helper()
+		w := httptest.NewRecorder()
+		route := credentialMetricsAPI{}.Routes()[0]
+		if err := route.Handler.ServeHTTP(w, httptest.NewRequest("GET", "http://localhost/guardex/clients", nil)); err != nil {
+			t.Fatal(err)
+		}
+		var rows []struct {
+			Username string `json:"username"`
+			Inbound  int64  `json:"inbound"`
+			Outbound int64  `json:"outbound"`
+		}
+		if err := json.Unmarshal(w.Body.Bytes(), &rows); err != nil {
+			t.Fatal(err)
+		}
+		result := make(map[string]struct {
+			Inbound  int64 `json:"inbound"`
+			Outbound int64 `json:"outbound"`
+		})
+		for _, row := range rows {
+			result[row.Username] = struct {
+				Inbound  int64 `json:"inbound"`
+				Outbound int64 `json:"outbound"`
+			}{row.Inbound, row.Outbound}
+		}
+		return result
+	}
+	baselineMetrics := metrics()
+	if baselineMetrics["alice"].Inbound < 10 || baselineMetrics["alice"].Outbound < 10 || baselineMetrics["bob"].Inbound < 10 || baselineMetrics["bob"].Outbound < 10 {
+		t.Fatal("server-side CONNECT traffic not accounted")
+	}
+	if e := load([]string{two}, true); e == nil {
+		t.Fatal("malformed inventory accepted")
+	}
+	if e := exchange(a2); e != nil {
+		t.Fatal("validation affected existing stream", e)
+	}
+
+	postStartFailure = true
+	failure := load([]string{two}, false)
+	postStartFailure = false
+	if failure == nil || !strings.Contains(failure.Error(), "loading config loader module") {
+		t.Fatalf("did not reach post-Start finishSettingUp failure: %v", failure)
+	}
+	if e := exchange(a1); e == nil {
+		t.Fatal("revoked old H1 resurrected after rollback")
+	}
+	if e := exchange(a2); e == nil {
+		t.Fatal("revoked old H2 resurrected after rollback")
+	}
+	for _, f := range []flow{b1, b2} {
+		if e := exchange(f); e != nil {
+			t.Fatal("failed reload disrupted unchanged user", e)
+		}
+	}
+	// Actual context unload must restore old authority for NEW connections.
+	a1, a2 = h1(one), h2(one)
+	defer a1.close()
+	defer a2.close()
+	for _, f := range []flow{a1, a2} {
+		if e := exchange(f); e != nil {
+			t.Fatal("post-Start cleanup failed to restore old authority", e)
+		}
+	}
+
+	before := time.Now()
+	if e := load([]string{two}, false); e != nil {
+		t.Fatal(e)
+	}
+	if e := exchange(a1); e == nil {
+		t.Fatal("revoked H1 flow survived")
+	}
+	if e := exchange(a2); e == nil {
+		t.Fatal("revoked H2 flow survived")
+	}
+	for _, f := range []flow{b1, b2} {
+		if e := exchange(f); e != nil {
+			t.Fatal("unchanged user's original stream interrupted", e)
+		}
+	}
+	after := metrics()
+	if after["alice"].Inbound < baselineMetrics["alice"].Inbound || after["bob"].Outbound < baselineMetrics["bob"].Outbound {
+		t.Fatal("reload reset traffic counters")
+	}
+	t.Logf("targeted H1/H2 revocation after reload: %s", time.Since(before))
+	// Use a new H1 request to verify cached credentials cannot reconnect.
+	assertDenied := func(token string) {
+		t.Helper()
+		c, e := net.DialTimeout("tcp", addr, time.Second)
+		if e != nil {
+			t.Fatal(e)
+		}
+		defer c.Close()
+		c.SetDeadline(time.Now().Add(time.Second))
+		fmt.Fprintf(c, "CONNECT %s HTTP/1.1\r\nHost: %s\r\nProxy-Authorization: Basic %s\r\n\r\n", echo.Addr(), echo.Addr(), token)
+		response, e := http.ReadResponse(bufio.NewReader(c), nil)
+		if e != nil {
+			t.Fatal(e)
+		}
+		if response.StatusCode != 407 {
+			t.Fatal("revoked credential accepted", response.StatusCode)
+		}
+	}
+	assertDenied(one)
+	if e := load([]string{one, two}, false); e != nil {
+		t.Fatal(e)
+	}
+	restored := h2(one)
+	defer restored.close()
+	if e := exchange(restored); e != nil {
+		t.Fatal("restored membership denied", e)
+	}
+	for _, f := range []flow{b1, b2} {
+		if e := exchange(f); e != nil {
+			t.Fatal("restoration interrupted other user", e)
+		}
+	}
+	// Authoritative [] closes the last users; missing/null is never deny-all.
+	if e := load([]string{}, false); e != nil {
+		t.Fatal("authoritative empty rejected", e)
+	}
+	for _, f := range []flow{b1, b2, restored} {
+		if e := exchange(f); e == nil {
+			t.Fatal("last-user stream survived deny-all")
+		}
+	}
+	assertDenied(two)
+	if liveCredentialFlows.current == nil || len(liveCredentialFlows.current.allowed) != 0 {
+		t.Fatal("deny-all authority not active")
+	}
+	if e := load([]string{one, two}, false); e != nil {
+		t.Fatal("restore from deny-all", e)
+	}
+	final := h2(one)
+	defer final.close()
+	if e := exchange(final); e != nil {
+		t.Fatal("restore after last-user revoke failed", e)
+	}
+
+}
