+package forwardproxy
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"net"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/caddyserver/caddy/v2"
+	"github.com/caddyserver/caddy/v2/caddyconfig"
+	"github.com/caddyserver/caddy/v2/caddyconfig/caddyfile"
+	"github.com/caddyserver/caddy/v2/caddyconfig/httpcaddyfile"
+)
+
+func init() {
+	caddy.RegisterModule(LiveCredentials{})
+	caddy.RegisterModule(credentialMetricsAPI{})
+	httpcaddyfile.RegisterGlobalOption("guardex_credentials", func(d *caddyfile.Dispenser, existing any) (any, error) {
+		if existing != nil {
+			return nil, d.Err("guardex_credentials may appear only once")
+		}
+		d.Next()
+		app := &LiveCredentials{Keys: append([]string{}, d.RemainingArgs()...)}
+		if err := app.Provision(caddy.Context{}); err != nil {
+			return nil, d.Err("invalid Guardex credential inventory")
+		}
+		return httpcaddyfile.App{Name: "guardex_credentials", Value: caddyconfig.JSON(app, nil)}, nil
+	})
+}
+
+// LiveCredentials publishes the accepted credential hashes when Caddy starts a
+// configuration, not during validation/provisioning. Handler generations share
+// this registry: a graceful HTTP reload must not retain revoked CONNECT flows.
+type LiveCredentials struct {
+	Keys     []string `json:"keys"`
+	allowed  map[string]struct{}
+	previous *LiveCredentials
+	stopped  bool
+}
+
+func (LiveCredentials) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{ID: "guardex_credentials", New: func() caddy.Module { return new(LiveCredentials) }}
+}
+
+func (a *LiveCredentials) Provision(_ caddy.Context) error {
+	if a.Keys == nil || len(a.Keys) > 100000 {
+		return errors.New("invalid Guardex credential inventory")
+	}
+	a.allowed = make(map[string]struct{}, len(a.Keys))
+	for _, key := range a.Keys {
+		raw, err := hex.DecodeString(key)
+		if err != nil || len(raw) != 32 || strings.ToLower(key) != key {
+			return errors.New("invalid Guardex credential hash")
+		}
+		if _, ok := a.allowed[key]; ok {
+			return errors.New("duplicate Guardex credential hash")
+		}
+		a.allowed[key] = struct{}{}
+	}
+	return nil
+}
+
+var liveCredentialFlows = struct {
+	sync.Mutex
+	current  *LiveCredentials
+	counters map[string]*credentialCounter
+	next     uint64
+	flows    map[uint64]*credentialFlow
+}{flows: make(map[uint64]*credentialFlow), counters: make(map[string]*credentialCounter)}
+
+func (a *LiveCredentials) Start() error {
+	liveCredentialFlows.Lock()
+	a.previous = liveCredentialFlows.current
+	liveCredentialFlows.current = a
+	a.stopped = false
+	stops := revokedCredentialFlowsLocked(a)
+	liveCredentialFlows.Unlock()
+	for _, flow := range stops {
+		flow.stop()
+	}
+	return nil
+}
+
+func (a *LiveCredentials) Stop() error {
+	liveCredentialFlows.Lock()
+	a.stopped = true
+	var stops []*credentialFlow
+	if liveCredentialFlows.current == a {
+		// Restore the old app if startup of the new configuration failed. An old
+		// app already stopped after a successful reload must never be restored.
+		previous := a.previous
+		for previous != nil && previous.stopped {
+			previous = previous.previous
+		}
+		liveCredentialFlows.current = previous
+		stops = revokedCredentialFlowsLocked(previous)
+	} else if liveCredentialFlows.current != nil && liveCredentialFlows.current.previous == a {
+		liveCredentialFlows.current.previous = a.previous
+	}
+	a.previous = nil
+	liveCredentialFlows.Unlock()
+	for _, flow := range stops {
+		flow.stop()
+	}
+	return nil
+}
+
+func revokedCredentialFlowsLocked(app *LiveCredentials) []*credentialFlow {
+	var removed []*credentialFlow
+	for id, flow := range liveCredentialFlows.flows {
+		if app != nil {
+			if _, ok := app.allowed[flow.key]; ok {
+				continue
+			}
+		}
+		removed = append(removed, flow)
+		delete(liveCredentialFlows.flows, id)
+	}
+	return removed
+}
+
+type credentialFlow struct {
+	key     string
+	stats   *credentialCounter
+	cancel  context.CancelFunc
+	mu      sync.Mutex
+	conn    net.Conn
+	stopped bool
+}
+
+func credentialHash(authorization string) string {
+	parts := strings.Fields(authorization)
+	if len(parts) != 2 || !strings.EqualFold(parts[0], "Basic") {
+		return ""
+	}
+	digest := sha256.Sum256([]byte(parts[1]))
+	return hex.EncodeToString(digest[:])
+}
+
+func trackCredentialFlow(authorization string, cancel context.CancelFunc) (*credentialFlow, func(), bool) {
+	flow := &credentialFlow{key: credentialHash(authorization), cancel: cancel}
+	liveCredentialFlows.Lock()
+	defer liveCredentialFlows.Unlock()
+	app := liveCredentialFlows.current
+	if app == nil {
+		return flow, func() {}, false
+	}
+	if _, ok := app.allowed[flow.key]; !ok {
+		return flow, func() {}, false
+	}
+	raw, _ := base64.StdEncoding.DecodeString(strings.Fields(authorization)[1])
+	username, _, _ := strings.Cut(string(raw), ":")
+	stats := liveCredentialFlows.counters[username]
+	if stats == nil {
+		stats = &credentialCounter{username: username}
+		liveCredentialFlows.counters[username] = stats
+	}
+	flow.stats = stats
+	stats.sessions.Add(1)
+	liveCredentialFlows.next++
+	id := liveCredentialFlows.next
+	liveCredentialFlows.flows[id] = flow
+	var once sync.Once
+	return flow, func() {
+		once.Do(func() {
+			flow.stats.sessions.Add(-1)
+			liveCredentialFlows.Lock()
+			delete(liveCredentialFlows.flows, id)
+			liveCredentialFlows.Unlock()
+		})
+	}, true
+}
+
+func (f *credentialFlow) bind(conn net.Conn) {
+	f.mu.Lock()
+	f.conn = conn
+	stopped := f.stopped
+	f.mu.Unlock()
+	if stopped {
+		_ = conn.Close()
+	}
+}
+
+func (f *credentialFlow) stop() {
+	f.mu.Lock()
+	f.stopped = true
+	conn := f.conn
+	f.mu.Unlock()
+	f.cancel()
+	if conn != nil {
+		_ = conn.Close()
+	}
+}
+
+// Caddy's post-Start finishSettingUp failures unload module contexts without
+// calling App.Stop. Context cleanup must restore authority in that path too.
+// Stop is lock-protected and idempotent when both lifecycle hooks run.
+func (a *LiveCredentials) Cleanup() error { return a.Stop() }
+
+var _ caddy.CleanerUpper = (*LiveCredentials)(nil)
+var _ caddy.App = (*LiveCredentials)(nil)
+var _ caddy.Provisioner = (*LiveCredentials)(nil)
+
+// Counters survive configuration reloads. Backend keeps this source independent
+// from TrustTunnel so restarting either runtime cannot double-charge the other.
+type credentialCounter struct {
+	username                    string
+	inbound, outbound, sessions atomic.Int64
+}
+type credentialMeteredConn struct {
+	net.Conn
+	stats *credentialCounter
+}
+
+func (c *credentialMeteredConn) Read(p []byte) (int, error) {
+	n, e := c.Conn.Read(p)
+	c.stats.outbound.Add(int64(n))
+	return n, e
+}
+func (c *credentialMeteredConn) Write(p []byte) (int, error) {
+	n, e := c.Conn.Write(p)
+	c.stats.inbound.Add(int64(n))
+	return n, e
+}
+func (c *credentialMeteredConn) CloseWrite() error {
+	if w, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return w.CloseWrite()
+	}
+	return nil
+}
+
+type credentialMetricsAPI struct{}
+
+func (credentialMetricsAPI) CaddyModule() caddy.ModuleInfo {
+	return caddy.ModuleInfo{ID: "admin.api.guardex_traffic", New: func() caddy.Module { return new(credentialMetricsAPI) }}
+}
+func (credentialMetricsAPI) Routes() []caddy.AdminRoute {
+	return []caddy.AdminRoute{{Pattern: "/guardex/clients", Handler: caddy.AdminHandlerFunc(func(w http.ResponseWriter, r *http.Request) error {
+		if r.Method != http.MethodGet {
+			w.WriteHeader(http.StatusMethodNotAllowed)
+			return nil
+		}
+		type metric struct {
+			Username string `json:"username"`
+			Sessions int64  `json:"sessions"`
+			Inbound  int64  `json:"inbound"`
+			Outbound int64  `json:"outbound"`
+		}
+		result := make([]metric, 0)
+		liveCredentialFlows.Lock()
+		for _, c := range liveCredentialFlows.counters {
+			result = append(result, metric{c.username, c.sessions.Load(), c.inbound.Load(), c.outbound.Load()})
+		}
+		liveCredentialFlows.Unlock()
+		w.Header().Set("Content-Type", "application/json")
+		return json.NewEncoder(w).Encode(result)
+	})}}
+}
