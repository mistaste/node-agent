+                let (mut read, mut write) = socket.split();
+                let _ = tokio::io::copy(&mut read, &mut write).await;
+            });
+        }
+    };
+    let exercise = async {
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        let mut alice =
+            common::Http3Session::connect(&address, common::MAIN_DOMAIN_NAME, None).await;
+        assert_eq!(
+            alice.exchange(request("alice", target)).await.0.status,
+            http::StatusCode::OK
+        );
+        async fn transfer(session: &mut common::Http3Session) {
+            let payload = vec![0x47; 4096];
+            session.send(futures::stream::iter([payload.clone()])).await;
+            let mut result = Vec::new();
+            while result.len() < payload.len() {
+                let mut buffer = [0; 4096];
+                let n = session.recv(&mut buffer).await;
+                assert!(n > 0);
+                result.extend_from_slice(&buffer[..n]);
+            }
+            assert_eq!(result, payload);
+        }
+        transfer(&mut alice).await;
+        let clients = [client("alice"), client("bob")];
+        core.reload_client_limits(&clients);
+        registry.replace(&clients);
+        let mut bob = common::Http3Session::connect(&address, common::MAIN_DOMAIN_NAME, None).await;
+        assert_eq!(
+            bob.exchange(request("bob", target)).await.0.status,
+            http::StatusCode::OK
+        );
+        transfer(&mut bob).await;
+        transfer(&mut alice).await;
+        let clients = [client("alice")];
+        core.reload_client_limits(&clients);
+        registry.replace(&clients);
+        let mut buffer = [0; 1];
+        assert_eq!(
+            tokio::time::timeout(Duration::from_secs(1), bob.recv(&mut buffer))
+                .await
+                .unwrap(),
+            0
+        );
+        transfer(&mut alice).await;
+    };
+    tokio::select! {
+        _ = core.listen() => panic!("endpoint stopped"),
+        _ = serving => panic!("echo stopped"),
+        _ = exercise => {},
+        _ = tokio::time::sleep(Duration::from_secs(10)) => panic!("H3 reload gate timed out"),
+    }
+}
+
+fn fixture() -> (
+    SocketAddr,
+    Arc<RegistryBasedAuthenticator>,
+    Arc<Core>,
+    common::File,
+) {
+    let address = common::make_endpoint_address();
+    let cert = common::make_cert_key_file();
+    let hosts = TlsHostsSettings::builder()
+        .main_hosts(vec![TlsHostInfo {
+            hostname: common::MAIN_DOMAIN_NAME.into(),
+            cert_chain_path: cert.path.to_str().unwrap().into(),
+            private_key_path: cert.path.to_str().unwrap().into(),
+            allowed_sni: vec![],
+        }])
+        .build()
+        .unwrap();
+    let settings = Settings::builder()
+        .listen_address(address)
+        .unwrap()
+        .clients(vec![client("alice")])
+        .listen_protocols(ListenProtocolSettings {
+            http1: None,
+            http2: Some(Http2Settings::builder().build()),
+            quic: Some(QuicSettings::builder().build()),
+        })
+        .allow_private_network_connections(true)
+        .build()
+        .unwrap();
+    let registry = Arc::new(RegistryBasedAuthenticator::new(settings.get_clients()));
+    let core =
+        Arc::new(Core::new(settings, Some(registry.clone()), hosts, Shutdown::new()).unwrap());
+    (address, registry, core, cert)
