+/// Parse completely before mutating authentication. Empty or duplicate client
+/// sets are never acknowledged. Agent renders a disabled sentinel for zero users.
+fn read_reload_clients(path: &Path) -> Result<(Vec<u8>, Vec<Client>), ()> {
+    let raw = std::fs::read(path).map_err(|_| ())?;
+    if raw.len() > 16 * 1024 * 1024 {
+        return Err(());
+    }
+    let document: toml::Value =
+        toml::from_str(std::str::from_utf8(&raw).map_err(|_| ())?).map_err(|_| ())?;
+    let array = document
+        .get("client")
+        .and_then(toml::Value::as_array)
+        .ok_or(())?;
+    if array.is_empty() {
+        return Err(());
+    }
+    let mut clients = Vec::with_capacity(array.len());
+    let mut users = std::collections::HashSet::new();
+    for value in array {
+        let client: Client = value.clone().try_into().map_err(|_| ())?;
+        if client.username.is_empty()
+            || client.password.is_empty()
+            || !users.insert(client.username.clone())
+        {
+            return Err(());
+        }
+        clients.push(client);
+    }
+    Ok((raw, clients))
+}
