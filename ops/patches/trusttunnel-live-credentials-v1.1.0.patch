+++ b/lib/tests/live_credentials.rs
@@ -0,0 +1,210 @@
+use base64::{engine::general_purpose::STANDARD, Engine};
+use std::{net::SocketAddr, sync::Arc, time::Duration};
+use tokio::io::{AsyncReadExt, AsyncWriteExt};
+use trusttunnel::{
+    authentication::registry_based::{Client, RegistryBasedAuthenticator},
+    core::Core,
+    net_utils,
+    settings::*,
+    shutdown::Shutdown,
+};
+#[allow(dead_code)]
+mod common;
+
+fn client(user: &str) -> Client {
+    Client {
+        username: user.into(),
+        password: "fixture".into(),
+        max_http2_conns: Some(8),
+        max_http3_conns: Some(8),
+    }
+}
+fn request(user: &str, target: SocketAddr) -> http::Request<hyper::Body> {
+    http::Request::connect(target.to_string())
+        .header(
+            http::header::PROXY_AUTHORIZATION,
+            format!("Basic {}", STANDARD.encode(format!("{user}:fixture"))),
+        )
+        .body(hyper::Body::empty())
+        .unwrap()
+}
+async fn h2(
+    address: SocketAddr,
+    user: &str,
+    target: SocketAddr,
+) -> Result<hyper::upgrade::Upgraded, http::StatusCode> {
+    let tls = common::establish_tls_connection(
+        common::MAIN_DOMAIN_NAME,
+        &address,
+        Some(net_utils::HTTP2_ALPN.as_bytes()),
+    )
+    .await;
+    let (mut sender, driver) = hyper::client::conn::Builder::new()
+        .http2_only(true)
+        .handshake(tls)
+        .await
+        .unwrap();
+    tokio::spawn(async move {
+        let _ = driver.await;
+    });
+    let response = sender.send_request(request(user, target)).await.unwrap();
+    if response.status() != http::StatusCode::OK {
+        return Err(response.status());
+    }
+    Ok(hyper::upgrade::on(response).await.unwrap())
+}
+async fn echo(stream: &mut hyper::upgrade::Upgraded) {
+    // Write and read concurrently to exercise full flow-control windows.
+    let payload = vec![0x47; 262144];
+    let (mut read, mut write) = tokio::io::split(stream);
+    let mut result = vec![0; payload.len()];
+    tokio::try_join!(write.write_all(&payload), read.read_exact(&mut result)).unwrap();
+    assert_eq!(result, payload);
+}
+
+#[tokio::test]
+async fn h2_add_remove_preserves_other_live_stream_and_revokes_only_removed_user() {
+    let (address, registry, core, _cert) = fixture();
+    let echo_listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let target = echo_listener.local_addr().unwrap();
+    let serving = async {
+        loop {
+            let (mut socket, _) = echo_listener.accept().await.unwrap();
+            tokio::spawn(async move {
+                let (mut read, mut write) = socket.split();
+                let _ = tokio::io::copy(&mut read, &mut write).await;
+            });
+        }
+    };
+    let exercise = async {
+        tokio::time::sleep(Duration::from_millis(100)).await;
+        let mut alice = h2(address, "alice", target).await.unwrap();
+        echo(&mut alice).await;
+        assert!(h2(address, "bob", target).await.is_err());
+        let clients = [client("alice"), client("bob")];
+        core.reload_client_limits(&clients);
+        registry.replace(&clients);
+        let mut bob = h2(address, "bob", target).await.unwrap();
+        echo(&mut bob).await;
+        echo(&mut alice).await;
+        let clients = [client("alice")];
+        core.reload_client_limits(&clients);
+        registry.replace(&clients);
+        let mut buffer = [0; 1];
+        let closed = tokio::time::timeout(Duration::from_secs(1), bob.read(&mut buffer))
+            .await
+            .unwrap();
+        assert!(
+            closed.is_err() || closed.unwrap() == 0,
+            "revoked flow must close"
+        );
+        echo(&mut alice).await;
+        assert!(h2(address, "bob", target).await.is_err());
+    };
+    tokio::select! {
+        _ = core.listen() => panic!("endpoint stopped"),
+        _ = serving => panic!("echo stopped"),
+        _ = exercise => {},
+        _ = tokio::time::sleep(Duration::from_secs(10)) => panic!("live reload gate timed out"),
+    }
+}
