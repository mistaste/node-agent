@@ -0,0 +1,17 @@
+package forwardproxy
+
+import (
+ "encoding/binary"
+ "io"
+ "net"
+ "path/filepath"
+ "testing"
+)
+
+func TestAccountGrantFrame(t *testing.T) {
+ path:=filepath.Join(t.TempDir(),"qos.sock");l,err:=net.Listen("unix",path);if err!=nil{t.Fatal(err)};defer l.Close()
+ done:=make(chan error,1)
+ go func(){c,e:=l.Accept();if e!=nil{done<-e;return};defer c.Close();var f [41]byte;_,e=io.ReadFull(c,f[:]);if e==nil&&(string(f[:36])!="11111111-1111-1111-1111-111111111111"||f[36]!=1||binary.BigEndian.Uint32(f[37:])!=1234){e=io.ErrUnexpectedEOF};if e==nil{_,e=c.Write([]byte{1})};done<-e}()
+ b:=&accountBudget{socket:path,username:"11111111-1111-1111-1111-111111111111"};if err=b.grant(1234,1);err!=nil{t.Fatal(err)};if err=<-done;err!=nil{t.Fatal(err)}
+}
+func TestAccountBrokerAbsent(t *testing.T){b:=&accountBudget{socket:filepath.Join(t.TempDir(),"absent.sock"),username:"11111111-1111-1111-1111-111111111111"};if e:=b.grant(1000,0);e!=nil{t.Fatal(e)}}
