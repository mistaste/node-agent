@@ -0,0 +1,162 @@
+package forwardproxy
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"log"
+	"net"
+	"net/http"
+	"os"
+	"strings"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+type accountBudget struct{ socket, username string }
+
+var qosDegraded atomic.Bool
+
+func authenticatedBudget(r *http.Request, enabled bool) *accountBudget {
+	socket := os.Getenv("GUARDEX_ACCOUNT_QOS_SOCKET")
+	if socket == "" || !enabled {
+		return nil
+	}
+	parts := strings.SplitN(r.Header.Get("Proxy-Authorization"), " ", 2)
+	if len(parts) != 2 {
+		return nil
+	}
+	raw, err := base64.StdEncoding.DecodeString(parts[1])
+	if err != nil {
+		return nil
+	}
+	username, _, ok := strings.Cut(string(raw), ":")
+	if !ok || len(username) != 36 {
+		return nil
+	}
+	return &accountBudget{socket: socket, username: username}
+}
+func (b *accountBudget) grant(n int, direction byte) error {
+	if b == nil {
+		return nil
+	}
+	for n > 0 {
+		count := n
+		if count > 16384 {
+			count = 16384
+		}
+		conn, err := net.DialTimeout("unix", b.socket, 2*time.Second)
+		if err != nil {
+			if errors.Is(err, syscall.ENOENT) || errors.Is(err, syscall.ECONNREFUSED) {
+				if !qosDegraded.Swap(true) {
+					log.Print("ACCOUNT_QOS_UNAVAILABLE: bandwidth control bypassed; tunnel remains active")
+				}
+				return nil
+			}
+			return err
+		}
+		_ = conn.SetDeadline(time.Now().Add(62 * time.Second))
+		var frame [41]byte
+		copy(frame[:36], b.username)
+		frame[36] = direction
+		binary.BigEndian.PutUint32(frame[37:], uint32(count))
+		_, err = conn.Write(frame[:])
+		if err == nil {
+			var reply [1]byte
+			_, err = io.ReadFull(conn, reply[:])
+			if err == nil && reply[0] != 1 {
+				err = errors.New("ACCOUNT_QOS_REJECTED")
+			}
+		}
+		_ = conn.Close()
+		if err != nil {
+			time.Sleep(10 * time.Millisecond)
+			if _, statErr := os.Stat(b.socket); os.IsNotExist(statErr) {
+				if !qosDegraded.Swap(true) {
+					log.Print("ACCOUNT_QOS_UNAVAILABLE: bandwidth control bypassed; tunnel remains active")
+				}
+				return nil
+			}
+			return fmt.Errorf("ACCOUNT_QOS_IO: %w", err)
+		}
+		if qosDegraded.Swap(false) {
+			log.Print("ACCOUNT_QOS_RECOVERED")
+		}
+		n -= count
+	}
+	return nil
+}
+
+type accountConn struct {
+	net.Conn
+	budget *accountBudget
+}
+
+func wrapAccountConn(conn net.Conn, b *accountBudget) net.Conn {
+	if b == nil {
+		return conn
+	}
+	return &accountConn{Conn: conn, budget: b}
+}
+func (c *accountConn) Read(p []byte) (int, error) {
+	if len(p) > 16384 {
+		p = p[:16384]
+	}
+	n, e := c.Conn.Read(p)
+	if n > 0 {
+		if err := c.budget.grant(n, 1); err != nil {
+			return 0, err
+		}
+	}
+	return n, e
+}
+func (c *accountConn) Write(p []byte) (int, error) {
+	total := 0
+	for len(p) > 0 {
+		n := len(p)
+		if n > 16384 {
+			n = 16384
+		}
+		if err := c.budget.grant(n, 0); err != nil {
+			return total, err
+		}
+		sent, err := c.Conn.Write(p[:n])
+		total += sent
+		p = p[sent:]
+		if err != nil {
+			return total, err
+		}
+		if sent == 0 {
+			return total, io.ErrShortWrite
+		}
+	}
+	return total, nil
+}
+func (c *accountConn) CloseWrite() error {
+	if w, ok := c.Conn.(interface{ CloseWrite() error }); ok {
+		return w.CloseWrite()
+	}
+	return nil
+}
+
+type accountBody struct {
+	io.ReadCloser
+	budget    *accountBudget
+	direction byte
+}
+
+func (b *accountBody) Read(p []byte) (int, error) {
+	if len(p) > 16384 {
+		p = p[:16384]
+	}
+	n, e := b.ReadCloser.Read(p)
+	if n > 0 {
+		if err := b.budget.grant(n, b.direction); err != nil {
+			return 0, err
+		}
+	}
+	return n, e
+}
