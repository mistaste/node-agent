#!/usr/bin/env python3
"""Install fair AQM without replacing a multiqueue root or custom shaping."""
import argparse
import json
import pathlib
import re
import subprocess


def queue_plan(qdiscs):
    roots = [q for q in qdiscs if q.get('root')]
    if len(roots) != 1:
        raise ValueError('expected one root queue')
    root = roots[0]
    supported = {'fq', 'fq_codel', 'pfifo_fast', 'pfifo'}
    if root['kind'] == 'mq':
        leaves = [q for q in qdiscs if q.get('parent')]
        if not leaves or any(q['kind'] not in supported for q in leaves):
            raise ValueError('unsupported multiqueue leaf; preserve existing configuration')
        # Default mq roots have handle 0:, which cannot be addressed as a
        # parent by tc. Give the same mq root an explicit handle first; NIC
        # transmit queues remain multiqueue. Then address each leaf normally.
        if root.get('handle') == '0:':
            return [['root', 'handle', '1:', 'mq']] + [
                ['parent', '1:' + q['parent'].split(':')[1], 'fq_codel'] for q in leaves
            ]
        return [['parent', q['parent'], 'fq_codel'] for q in leaves if q['kind'] != 'fq_codel']
    if root['kind'] not in supported:
        raise ValueError('custom queue; preserve existing configuration')
    return [] if root['kind'] == 'fq_codel' else [['root', 'fq_codel']]


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('interface')
    args = parser.parse_args()
    iface = args.interface
    if not re.fullmatch(r'[A-Za-z0-9_.:-]+', iface) or not (pathlib.Path('/sys/class/net') / iface).exists():
        parser.error('invalid or unavailable network interface')
    before = json.loads(subprocess.check_output(['tc', '-j', 'qdisc', 'show', 'dev', iface]))
    plan = queue_plan(before)
    for operation in plan:
        subprocess.run(['tc', 'qdisc', 'replace', 'dev', iface, *operation], check=True)
    after = json.loads(subprocess.check_output(['tc', '-j', 'qdisc', 'show', 'dev', iface]))
    if queue_plan(after):
        raise RuntimeError('fair queue verification failed')
    print(json.dumps({'interface': iface, 'changes': plan, 'queues': after}))


if __name__ == '__main__':
    main()
