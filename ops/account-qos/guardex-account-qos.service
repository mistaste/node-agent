[Unit]
Description=Guardex Poland account bandwidth pilot
After=network.target
ConditionPathExists=/var/lib/guardex-account-qos/accounts.json
[Service]
Type=simple
Group=65532
RuntimeDirectory=guardex-account-qos
RuntimeDirectoryMode=0710
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/bin/rm -f /run/guardex-account-qos/broker.sock
ExecStart=/usr/local/sbin/guardex-account-qos --socket-gid=65532 --initial-mbps=96 --max-mbps=96 --min-mbps=32
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/guardex-account-qos /var/lib/guardex-account-qos
MemoryMax=192M
TasksMax=256
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target
