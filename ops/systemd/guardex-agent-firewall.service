[Unit]
Description=Guardex node management firewall from controller DNS
Documentation=https://github.com/mistaste/node-agent
Wants=network-online.target
After=network-online.target firewalld.service netfilter-persistent.service ufw.service
Before=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/guardex/node-firewall.conf
ExecStart=/usr/local/sbin/guardex-agent-firewall
TimeoutStartSec=30

[Install]
WantedBy=multi-user.target
