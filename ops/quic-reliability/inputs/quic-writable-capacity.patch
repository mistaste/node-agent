+#[cfg(test)]
+pub(crate) mod tests {
+    use super::*;
+
+    pub(crate) async fn assert_body_wait_capacity(socket: Arc<QuicSocket>) -> Arc<QuicSocket> {
+        let socket = Arc::try_unwrap(socket).unwrap_or_else(|_| panic!("fixture socket is shared"));
+        let parent = log_utils::IdChain::from(log_utils::IdItem::new("fixture={}", 1));
+        let mut codec = Http3Codec::new(socket, parent.clone());
+        let (read_tx, _read_rx) = mpsc::channel(1);
+        let (write_tx, write_rx) = mpsc::channel(1);
+        codec.streams.insert(
+            0,
+            Stream {
+                readable_event_tx: read_tx,
+                writable_event_tx: write_tx,
+                read_shutdown: false,
+                write_shutdown: false,
+                minimum_writable_capacity: net_utils::MIN_USABLE_QUIC_STREAM_CAPACITY,
+            },
+        );
+        let mut sink = StreamSink {
+            stream_id: 0,
+            socket: codec.socket.clone(),
+            writable_event_rx: write_rx,
+            codec_tx: codec.codec_tx.clone(),
+            data_frame_overhead: net_utils::MIN_USABLE_QUIC_STREAM_CAPACITY,
+            id: parent,
+            pending_response: None,
+        };
+        let remaining = pipe::Sink::write(&mut sink, Bytes::from(vec![0; 65536])).unwrap();
+        assert_eq!(remaining.len(), 65536);
+        let message = {
+            let waiting = sink.wait_body_capacity();
+            tokio::pin!(waiting);
+            tokio::select! {
+                result = &mut waiting => panic!("body wait completed without capacity: {result:?}"),
+                message = codec.stream_rx.recv() => message.unwrap(),
+            }
+        };
+        assert!(matches!(message, StreamMessage::WaitingWritable(0, 6)));
+        codec.on_stream_message(message).unwrap();
+        assert_eq!(codec.streams[&0].minimum_writable_capacity, 6);
+        codec.notify_writable_streams(vec![0]);
+        assert!(matches!(
+            sink.writable_event_rx.try_recv(),
+            Err(mpsc::error::TryRecvError::Empty)
+        ));
+        assert!(tokio::time::timeout(
+            std::time::Duration::from_millis(10),
+            sink.wait_body_capacity(),
+        )
+        .await
+        .is_err());
+        codec.socket.clone()
+    }
+}
