+    #[tokio::test]
+    async fn request_eof_wakes_pending_reader_and_keeps_response_open() {
+        use crate::quic_multiplexer::tests::request_body_fixture;
+        let (socket, mut peer) = request_body_fixture().await;
+        let parent = log_utils::IdChain::from(log_utils::IdItem::new("fixture={}", 6));
+        let mut codec = Http3Codec::new(socket, parent);
+        let request = http::Request::builder()
+            .uri("https://localhost/")
+            .body(())
+            .unwrap()
+            .into_parts()
+            .0;
+        let (source, pending) = codec.on_request(4, request).unwrap().split();
+        let mut source = source.finalize();
+        let mut reader = tokio::spawn(async move { source.read().await });
+        tokio::task::yield_now().await;
+        assert!(!reader.is_finished());
+        peer.finish_request(4);
+        peer.exchange(&codec.socket).await;
+        let event = tokio::time::timeout(std::time::Duration::from_secs(1), codec.socket.listen())
+            .await
+            .unwrap()
+            .unwrap();
+        assert!(matches!(event, QuicSocketEvent::Close(4)));
+        assert!(codec.on_socket_event(event).unwrap().is_none());
+        let data = tokio::time::timeout(std::time::Duration::from_secs(1), &mut reader)
+            .await
+            .expect("request EOF must wake a reader already waiting for data")
+            .unwrap()
+            .unwrap();
+        assert!(matches!(data, pipe::Data::Eof));
+        assert!(codec.streams[&4].read_shutdown);
+        assert!(!codec.streams[&4].write_shutdown);
+        let response = http::Response::builder()
+            .status(200)
+            .body(())
+            .unwrap()
+            .into_parts()
+            .0;
+        let mut sink = pending
+            .send_response(response, false)
+            .unwrap()
+            .into_pipe_sink();
+        assert!(sink
+            .write(Bytes::from_static(b"response after request EOF"))
+            .unwrap()
+            .is_empty());
+        sink.eof().unwrap();
+        peer.exchange(&codec.socket).await;
+        let (headers, finished, resets, body) = peer.observe_response(4);
+        assert_eq!(headers, 1);
+        assert_eq!(finished, 1);
+        assert!(resets.is_empty());
+        assert_eq!(body, b"response after request EOF");
+    }
