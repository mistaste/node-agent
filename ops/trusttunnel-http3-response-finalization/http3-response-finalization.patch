+    pub(super) struct LockProbe {
+        write_ready: std::sync::mpsc::SyncSender<()>,
+        write_action: std::sync::Mutex<std::sync::mpsc::Receiver<bool>>,
+        shutdown_entered: std::sync::mpsc::SyncSender<()>,
+        shutdown_first: std::sync::mpsc::SyncSender<()>,
+    }
+
+    impl LockProbe {
+        pub(super) fn write_locked(&self) -> bool {
+            let _ = self.write_ready.send(());
+            self.write_action.lock().unwrap().recv().unwrap_or(true)
+        }
+        pub(super) fn shutdown_entered(&self) {
+            let _ = self.shutdown_entered.send(());
+        }
+        pub(super) fn shutdown_first_lock(&self) {
+            let _ = self.shutdown_first.send(());
+        }
+    }
+
+    #[test]
+    fn graceful_shutdown_does_not_hold_quic_while_waiting_for_h3() {
+        let (write_ready_tx, write_ready_rx) = std::sync::mpsc::sync_channel(1);
+        let (write_action_tx, write_action_rx) = std::sync::mpsc::sync_channel(1);
+        let (entered_tx, entered_rx) = std::sync::mpsc::sync_channel(1);
+        let (first_tx, first_rx) = std::sync::mpsc::sync_channel(1);
+        let probe = Arc::new(LockProbe {
+            write_ready: write_ready_tx,
+            write_action: std::sync::Mutex::new(write_action_rx),
+            shutdown_entered: entered_tx,
+            shutdown_first: first_tx,
+        });
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        let (socket, _client_socket) = runtime.block_on(connected_socket(probe, 1));
+        let (done_tx, done_rx) = std::sync::mpsc::channel();
+        let writer = {
+            let socket = socket.clone();
+            let done = done_tx.clone();
+            std::thread::spawn(move || {
+                let result = socket.write(0, Bytes::from_static(b"payload"));
+                let _ = done.send(("writer", result.is_ok_and(|left| left.is_empty())));
+            })
+        };
+        write_ready_rx.recv_timeout(Duration::from_secs(3)).unwrap();
+        let shutdown = {
+            let socket = socket.clone();
+            let done = done_tx;
+            std::thread::spawn(move || {
+                let result = socket.graceful_shutdown();
+                let _ = done.send(("shutdown", result.is_ok()));
+            })
+        };
+        entered_rx.recv_timeout(Duration::from_secs(3)).unwrap();
+        let inverted = first_rx.recv_timeout(Duration::from_secs(1)).is_ok();
+        // Abort the paused writer on inversion so the regression cannot hang.
+        write_action_tx.send(inverted).unwrap();
+        let results = [
+            done_rx.recv_timeout(Duration::from_secs(3)).unwrap(),
+            done_rx.recv_timeout(Duration::from_secs(3)).unwrap(),
+        ];
+        writer.join().unwrap();
+        shutdown.join().unwrap();
+        assert!(!inverted, "shutdown held QUIC while a writer held HTTP3");
+        assert!(
+            results.iter().all(|(_, success)| *success),
+            "real methods failed: {results:?}"
+        );
+    }
+    #[test]
+    fn writable_notifications_respect_pending_frame_capacity() {
+        let runtime = tokio::runtime::Builder::new_current_thread()
+            .enable_all()
+            .build()
+            .unwrap();
+        for wanted_capacity in 3..=6 {
+            runtime.block_on(async {
+                let (write_ready, _) = std::sync::mpsc::sync_channel(1);
+                let (_, write_action) = std::sync::mpsc::sync_channel(1);
+                let (shutdown_entered, _) = std::sync::mpsc::sync_channel(1);
+                let (shutdown_first, _) = std::sync::mpsc::sync_channel(1);
+                let probe = Arc::new(LockProbe {
+                    write_ready,
+                    write_action: std::sync::Mutex::new(write_action),
+                    shutdown_entered,
+                    shutdown_first,
+                });
+                let (mut socket, _client_socket) = connected_socket(probe, 2).await;
+                Arc::get_mut(&mut socket).unwrap().lock_probe = None;
+                {
+                    let mut h3 = socket.h3_conn.lock().unwrap();
+                    let mut quic = socket.quic_conn.lock().unwrap();
+                    let capacity = quic.stream_capacity(0).unwrap();
+                    let length =
+                        capacity - wanted_capacity - net_utils::http3_data_frame_overhead(capacity);
+                    assert_eq!(
+                        h3.send_body(&mut quic, 0, &vec![0; length], false).unwrap(),
+                        length
+                    );
+                    assert_eq!(quic.stream_capacity(0).unwrap(), wanted_capacity);
+                }
+                socket.notify_stream_waiting_writable(0, 6);
+                socket.notify_stream_waiting_writable(4, 3);
+                let mut ready = socket.take_writable_streams();
+                ready.sort_unstable();
+                assert_eq!(
+                    ready,
+                    if wanted_capacity < 6 {
+                        vec![4]
+                    } else {
+                        vec![0, 4]
+                    }
+                );
+                socket.notify_stream_waiting_writable(8, 6);
+                assert_eq!(socket.take_writable_streams(), vec![8]);
+                assert!(socket.take_writable_streams().is_empty());
+                if wanted_capacity < 6 {
+                    assert_eq!(
+                        socket.waiting_writable_streams.lock().unwrap().get(&0),
+                        Some(&6)
+                    );
+                    socket.notify_stream_waiting_writable(0, wanted_capacity);
+                    assert_eq!(socket.take_writable_streams(), vec![0]);
+                }
+                assert!(socket.waiting_writable_streams.lock().unwrap().is_empty());
+                if wanted_capacity == 4 {
+                    let socket = crate::http3_codec::tests::assert_body_wait_capacity(socket).await;
+                    assert_eq!(
+                        socket.waiting_writable_streams.lock().unwrap().get(&0),
+                        Some(&6)
+                    );
+                    assert!(socket.take_writable_streams().is_empty());
+                } else if wanted_capacity == 6 {
+                    let data = Bytes::from(vec![0; 65536]);
+                    assert!(socket.write(0, data).unwrap().len() < 65536);
+                }
+            });
+        }
+    }
