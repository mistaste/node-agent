+    #[tokio::test]
+    async fn cancelled_request_readable_does_not_close_siblings() {
+        use crate::quic_multiplexer::tests::request_body_fixture;
+        for retired in [false, true] {
+            let (socket, mut peer) = request_body_fixture().await;
+            let parent = log_utils::IdChain::from(log_utils::IdItem::new("fixture={}", 5));
+            let mut codec = Http3Codec::new(socket, parent);
+            let request = http::Request::builder()
+                .uri("https://localhost/")
+                .body(())
+                .unwrap()
+                .into_parts()
+                .0;
+            let stream = codec.on_request(4, request).unwrap();
+            let (source, pending) = stream.split();
+            drop(source);
+            peer.send_request_body(4, b"cancelled request body");
+            peer.exchange(&codec.socket).await;
+            let event =
+                tokio::time::timeout(std::time::Duration::from_secs(1), codec.socket.listen())
+                    .await
+                    .unwrap()
+                    .unwrap();
+            assert!(matches!(event, QuicSocketEvent::Readable(4)));
+            if retired {
+                drop(pending);
+                for _ in 0..2 {
+                    let message = codec.stream_rx.recv().await.unwrap();
+                    codec.on_stream_message(message).unwrap();
+                }
+                assert!(!codec.streams.contains_key(&4));
+            }
+            assert!(codec.on_socket_event(event).unwrap().is_none());
+            if !retired {
+                assert!(codec.streams[&4].read_shutdown);
+                assert!(!codec.streams[&4].write_shutdown);
+            }
+            assert!(codec
+                .on_socket_event(QuicSocketEvent::Readable(4))
+                .unwrap()
+                .is_none());
+            assert!(
+                tokio::time::timeout(std::time::Duration::from_millis(20), codec.listen(),)
+                    .await
+                    .is_err()
+            );
+            assert!(codec
+                .socket
+                .write(0, Bytes::from_static(b"sibling survives"))
+                .unwrap()
+                .is_empty());
+            peer.exchange(&codec.socket).await;
+            let (_, _, resets, body) = peer.observe_response(0);
+            assert!(resets.is_empty());
+            assert!(body.ends_with(b"sibling survives"));
+        }
+    }
