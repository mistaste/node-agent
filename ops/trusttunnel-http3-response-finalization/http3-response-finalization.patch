+    #[tokio::test]
+    async fn dropping_uncommitted_response_resets_only_its_stream() {
+        use crate::quic_multiplexer::tests::{header_fixture, limit_fixture_capacity};
+        for blocked in [false, true] {
+            let (socket, mut peer) = header_fixture().await;
+            if blocked {
+                limit_fixture_capacity(&socket, 4);
+            }
+            let parent = log_utils::IdChain::from(log_utils::IdItem::new("fixture={}", 3));
+            let mut codec = Http3Codec::new(socket, parent);
+            let request = http::Request::builder()
+                .uri("https://localhost/")
+                .body(())
+                .unwrap()
+                .into_parts()
+                .0;
+            let stream = codec.on_request(4, request).unwrap();
+            let (source, pending) = stream.split();
+            if blocked {
+                let response = http::Response::builder()
+                    .status(200)
+                    .header("x-fixture", "x".repeat(128))
+                    .body(())
+                    .unwrap()
+                    .into_parts()
+                    .0;
+                let sink = pending.send_response(response, false).unwrap();
+                drop(sink);
+            } else {
+                drop(pending);
+            }
+            let message = codec.stream_rx.recv().await.unwrap();
+            codec.on_stream_message(message).unwrap();
+            peer.exchange(&codec.socket).await;
+            let (headers, finished, resets, body) = peer.observe_response(4);
+            assert_eq!(headers, 0);
+            assert_eq!(
+                finished, 0,
+                "unstarted response must not send a headerless FIN; blocked={blocked}"
+            );
+            assert_eq!(
+                resets,
+                [0x10c],
+                "unstarted response needs H3_REQUEST_CANCELLED; blocked={blocked}"
+            );
+            assert!(body.is_empty());
+            let mut remaining = Bytes::from_static(b"still healthy");
+            let mut received = Vec::new();
+            for _ in 0..32 {
+                peer.exchange(&codec.socket).await;
+                let (_, _, resets, body) = peer.observe_response(0);
+                assert!(resets.is_empty());
+                received.extend(body);
+                if remaining.is_empty() && received.ends_with(b"still healthy") {
+                    break;
+                }
+                remaining = codec.socket.write(0, remaining).unwrap();
+            }
+            assert!(remaining.is_empty());
+            assert!(received.ends_with(b"still healthy"));
+            drop(source);
+        }
+    }
