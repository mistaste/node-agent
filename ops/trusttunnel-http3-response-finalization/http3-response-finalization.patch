+        use crate::quic_multiplexer::tests::header_fixture;
+        let (socket, mut peer) = header_fixture().await;
+        let parent = log_utils::IdChain::from(log_utils::IdItem::new("fixture={}", 4));
+        let mut codec = Http3Codec::new(socket, parent);
+        let request = http::Request::builder()
+            .uri("https://localhost/")
+            .body(())
+            .unwrap()
+            .into_parts()
+            .0;
+        let stream = codec.on_request(4, request).unwrap();
+        let (source, pending) = stream.split();
+        let response = http::Response::builder()
+            .status(200)
+            .body(())
+            .unwrap()
+            .into_parts()
+            .0;
+        let mut sink = pending
+            .send_response(response, false)
+            .unwrap()
+            .into_pipe_sink();
+        let payload = Bytes::from_static(b"queued body survives EOF");
+        assert!(sink.write(payload.clone()).unwrap().is_empty());
+        sink.eof().unwrap();
+        drop(sink);
+        let message = codec.stream_rx.recv().await.unwrap();
+        codec.on_stream_message(message).unwrap();
+        peer.exchange(&codec.socket).await;
+        let (headers, finished, resets, body) = peer.observe_response(4);
+        assert_eq!(headers, 1);
+        assert_eq!(finished, 1);
+        assert!(resets.is_empty());
+        assert_eq!(body, payload);
+        drop(source);
+    }
